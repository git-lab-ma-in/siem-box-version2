# =========================================================
# .env — Cấu hình stack. Copy thành .env thật rồi điền SIEM_EXTERNAL_HOST.
# ELASTIC_PASSWORD / KIBANA_PASSWORD / ENCRYPTION_KEY: để TRỐNG,
# setup.sh sẽ tự sinh giá trị ngẫu nhiên mạnh nếu thiếu (không commit .env đã điền vào git).
# =========================================================

# --- Phiên bản Elastic Stack ---
STACK_VERSION=8.19.7
KAFKA_VERSION=3.7

# --- QUAN TRỌNG: địa chỉ mà collector/trình duyệt Ở MÁY KHÁC sẽ dùng để truy cập stack này ---
# Là IP thật của máy/VM chạy Docker (vd 192.168.1.50), KHÔNG dùng "localhost".
# Biến này được dùng lại ở 2 chỗ khác nhau (Kafka advertised listener + SAN của chứng chỉ TLS)
# để tránh lặp lại lỗi "advertised listener = localhost" đã gặp ở bản trước.
SIEM_EXTERNAL_HOST=CHANGE_ME

# --- Cổng expose ra host ---
ES_PORT=9200
KIBANA_PORT=5601
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8080

# --- Cluster / license ---
CLUSTER_NAME=siem-cluster
LICENSE=basic

# --- Mật khẩu & khoá mã hoá — để trống, setup.sh tự sinh ---
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
ENCRYPTION_KEY=

# --- Giới hạn RAM từng service ---
ES_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=1g
KAFKA_MEM_LIMIT=1.5g
LOGSTASH_MEM_LIMIT=1.5g
KAFKA_UI_MEM_LIMIT=512m

ES_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms512m -Xmx512m