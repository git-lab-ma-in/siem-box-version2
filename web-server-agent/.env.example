# .env — Copy thành .env rồi điền 2 giá trị dưới đây, PHẢI khớp với .env của
# siem-box đang chạy trên máy SIEM (2 biến cùng tên, cùng giá trị ở cả 2 nơi).

# IP/hostname thật của máy SIEM box (giống SIEM_EXTERNAL_HOST trong siem-box/.env)
SIEM_EXTERNAL_HOST=CHANGE_ME

# Cổng Kafka EXTERNAL đã publish ra host của SIEM box (giống KAFKA_EXTERNAL_PORT
# trong siem-box/.env.example, mặc định 9094)
KAFKA_EXTERNAL_PORT=9094
