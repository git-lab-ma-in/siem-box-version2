# siem-webshell.rules
# Cài vào /etc/audit/rules.d/ trên máy chủ web (install.sh làm việc này tự động).
#
# Mục tiêu: ghi lại MỌI execve có euid = 33 (www-data trên Debian/Ubuntu — user
# mà nginx/php-fpm chạy dưới quyền). Đây là dấu hiệu chính của web shell / RCE:
# ứng dụng web bị khai thác rồi spawn ra một shell hoặc binary khác.
#
# Nếu máy chủ web của bạn dùng user khác (không phải www-data uid 33, ví dụ
# "nginx" trên RHEL thường là uid 993, hoặc "apache" tuỳ distro) — sửa euid=33
# thành uid thật, kiểm tra bằng: id -u <tên-user-chạy-web-server>
#
# key "webshell_exec" phải khớp với field "key" mà rules/sigma/webshell-exec.yml
# (phía siem-box) tìm kiếm — không đổi tên key này nếu không sửa rule Sigma
# tương ứng.

-a always,exit -F arch=b64 -S execve -F euid=33 -k webshell_exec
-a always,exit -F arch=b32 -S execve -F euid=33 -k webshell_exec
